#include <windows.h>

// the application icon (tools/make_icon.ps1 builds it from resources/prismfs-dark.png): id 1 is what explorer, the
// taskbar and alt-tab show for the exe
1 ICON "../resources/prismfs.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "PrismFS file explorer"
            VALUE "ProductName",     "PrismFS"
            VALUE "InternalName",    "prismfs"
            VALUE "OriginalFilename","prismfs.exe"
            VALUE "FileVersion",     "0.1.0"
            VALUE "ProductVersion",  "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
